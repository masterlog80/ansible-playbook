# Managed by Ansible – do not edit manually.
# Template: templates/zshrc.j2

# Enable Powerlevel10k instant prompt. Should stay close to the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
{% for plugin in zsh_plugins %}
  {{ plugin }}
{% endfor %}
)

# Do not break interactive login if an earlier Oh My Zsh install was
# interrupted. The Ansible zsh tasks will repair the installation on rerun.
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -P "%F{yellow}Oh My Zsh is missing; run the Ansible bootstrap to repair it.%f"
fi

# Load Powerlevel10k config if it exists.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
